# Copy this file to a PRIVATE env file (e.g. api-analytics.env) and fill in real
# values. Pass it to the container with:  docker run --env-file your-private.env ...
# DO NOT commit the filled-in file.

# IBM Cloud API key used to request an IAM access token
IBM_API_KEY=your-ibm-cloud-api-key

# Credentials required to access the web app
APP_AUTH_USER=apic
APP_AUTH_PASS=change-me

